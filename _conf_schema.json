{
  "command_prefix": {
    "description": "【重要】插件命令前缀",
    "type": "string",
    "hint": "用于触发本插件的命令，默认为 /acm。通常无需修改。",
    "default": "/acm"
  },
  "webui_port": {
    "description": "【系统】网页仪表盘的端口号",
    "type": "int",
    "hint": "修改后需要重启插件的WebUI才能生效",
    "default": 8088
  },
  "admin_qq_id": {
    "description": "【重要】机器人管理员QQ号",
    "type": "string",
    "hint": "用于接收重要错误通知，请务必填写。"
  },
  "contest_reminder": {
    "description": "【CF】比赛订阅提醒（测试）",
    "type": "object",
    "hint": "仅向白名单群聊发送提醒；比赛列表每10分钟刷新一次。",
    "items": {
      "enabled": {
        "description": "启用比赛订阅提醒",
        "type": "bool",
        "default": false
      },
      "group_whitelist": {
        "description": "群聊提醒白名单",
        "type": "list",
        "default": [],
        "items": {
          "type": "string"
        },
        "hint": "手动添加允许接收提醒的QQ群号；不在白名单中的群聊绝不会收到提醒。"
      },
      "reminder_times": {
        "description": "提前提醒时间",
        "type": "string",
        "default": "24 1",
        "hint": "使用空格分隔多组时间；纯数字默认单位为小时，也支持1min、1s、1h、1d，范围为1秒至365天。例如：24 1 30min。"
      },
      "include_div2": {
        "description": "提醒 Div. 2 比赛",
        "type": "bool",
        "default": true
      },
      "include_div3": {
        "description": "提醒 Div. 3 比赛",
        "type": "bool",
        "default": true
      },
      "include_div4": {
        "description": "提醒 Div. 4 比赛",
        "type": "bool",
        "default": true
      },
      "include_educational": {
        "description": "提醒 Educational 比赛",
        "type": "bool",
        "default": true
      },
      "include_other": {
        "description": "提醒其他类型比赛",
        "type": "bool",
        "default": false,
        "hint": "包括未匹配到 Div. 2/3/4 或 Educational 的常规 Codeforces 比赛。"
      }
    }
  },
  "cf_api_key": {
    "description": "【CF-可选】API Key",
    "type": "string",
    "hint": "用于签名访问 Codeforces API；不会绕过官方请求频率限制，没有可不填。"
  },
  "cf_api_secret": {
    "description": "【CF-可选】API Secret",
    "type": "string",
    "hint": "与CF API Key配对使用，没有可不填。"
  }
}
